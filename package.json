{
  "name": "@astralux/dsh-token-dashboard",
  "version": "0.2.0",
  "description": "DeepSeek Harness 用量看板：账户余额、Token 使用量、按缓存命中/未命中输入与输出的成本拆分，附一年活跃度热力图与分工作区趋势曲线。Fork of @lyk308/dsh-token-dashboard with dsh 0.2.0-rc.2 compatibility fixes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/screenshot-overview.png",
    "docs/screenshot-usage.png",
    "docs/screenshot-activity.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "token",
    "balance",
    "usage",
    "cost",
    "dashboard"
  ],
  "license": "MIT",
  "author": "LynnChrysteiin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LynnChrysteiin/dsh-token-dashboard.git"
  },
  "homepage": "https://github.com/LynnChrysteiin/dsh-token-dashboard#readme",
  "bugs": {
    "url": "https://github.com/LynnChrysteiin/dsh-token-dashboard/issues"
  }
}
